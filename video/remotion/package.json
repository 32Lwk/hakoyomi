{
  "name": "hakoyomi-video-remotion",
  "private": true,
  "version": "0.0.0",
  "description": "ハコよみ デモ動画（T603）の Remotion 素材と組み立て",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-recordings.mjs",
    "prestudio": "node scripts/sync-recordings.mjs",
    "studio": "remotion studio src/index.ts",
    "narration": "node scripts/narration-gemini.mjs",
    "narration:gemini": "node scripts/narration-gemini.mjs",
    "narration:measure": "node scripts/narration-gemini.mjs --measure-only",
    "narration:say": "node scripts/narration.mjs",
    "prerender": "node scripts/sync-recordings.mjs",
    "render": "remotion render src/index.ts Main out/main.mp4",
    "render:draft": "node scripts/sync-recordings.mjs && remotion render src/index.ts Main out/main-draft.mp4 --scale=0.5 --crf=30",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
