      "itemNo": "3.(1)",
      "body": "目のかすみが改善されない場合．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_jinko-sd-3-2",
