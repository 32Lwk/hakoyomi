    {
      "id": "vitamin_c-etc-youho-1",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(1)",
      "body": "小児に服用させる場合には，保護者の指導監督のもとに服用させること．",
      "condition": {
        "usageUnderMonths": 180
      },
      "conditionText": "小児の用法及び用量がある場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-youho-2-1",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(2)1)",
      "body": "３歳以上の幼児に服用させる場合には，薬剤がのどにつかえることのないよう，よく注意すること．",
      "condition": {
        "all": [
          {
            "usageUnderMonths": 60
          },
          {
            "dosageForm": [
              "錠剤",
              "丸剤",
              "軟カプセル剤"
            ]
          }
        ]
      },
      "conditionText": "５歳未満の幼児の用法がある錠剤（発泡錠を除く）・丸剤・軟カプセル剤の場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-youho-2-2",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(2)2)",
      "body": "乳幼児に服用させる場合には ，薬剤がのどにつかえることのないよう ，よく注意すること．",
      "condition": {
        "all": [
          {
            "usageUnderMonths": 180
          },
          {
            "usageUnderMonths": 36
          },
          {
            "dosageForm": [
              "チュアブル錠",
              "ゼリー状ドロップ剤"
            ]
          }
        ]
      },
      "conditionText": "３歳未満の乳幼児の用法があるチュアブル錠又はゼリー状ドロップ剤の場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-youho-3",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(3)",
      "body": "必ずかんで服用すること．",
      "condition": {
        "dosageForm": [
          "ゼリー状ドロップ剤"
        ]
      },
      "conditionText": "ゼリー状ドロップ剤の場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-youho-4",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(4)",
      "body": "内服にのみ使用すること．",
