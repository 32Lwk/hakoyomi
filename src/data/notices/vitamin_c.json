      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(2)",
      "body": "小児の手の届かない所に保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-hokan-3",
