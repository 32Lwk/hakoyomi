        "dosageForm": [
          "アンプル剤"
        ]
      },
      "conditionText": "アンプル剤の場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "vitamin_c-etc-hokan-1",
      "groupId": "vitamin_c",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(1)",
      "body": "直射日光の当たらない（湿気の少ない）涼しい所に（密栓して）保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": "（ ）内は必要とする場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
