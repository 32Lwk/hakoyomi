      "needsReview": true
    },
    {
      "id": "chinyou_shoen-etc-youho-6",
      "groupId": "chinyou_shoen",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(6)",
      "body": "同じ箇所に連続して○秒以上噴霧しないこと．",
      "condition": {
        "dosageForm": [
          "エアゾール剤"
        ]
      },
      "conditionText": "エアゾール剤の場合に当該製品の至適な時間を３秒を超えない範囲で記載すること．",
