  "items": [
    {
      "id": "mizumushi-ng-1",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "1.",
      "body": "次の人は使用しないこと\n本剤又は本剤の成分，クロルヘキシジンによりアレルギー症状を起こしたことがある人．",
      "condition": {
        "hasIngredient": [
          "クロルヘキシジングルコン酸塩",
          "クロルヘキシジン塩酸塩"
        ]
      },
      "conditionText": "ヨードチンキ，クロルヘキシジングルコン酸塩又はクロルヘキシジン塩酸塩を含有する製剤に記載すること． ただし，「，クロルヘキシジン」はクロルヘキシジングルコン酸塩又はクロルヘキシジン塩酸塩を含有する製剤にのみ記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-ng-1-v2",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "1.v2",
      "body": "次の人は使用しないこと\n本剤又は本剤の成分によりアレルギー症状を起こしたことがある人．",
      "condition": {
        "all": [
          {
            "hasIngredient": [
              "ヨードチンキ"
            ]
          },
          {
            "not": {
              "hasIngredient": [
                "クロルヘキシジングルコン酸塩",
