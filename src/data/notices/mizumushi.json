            }
          }
        ]
      },
      "conditionText": "ヨードチンキ，クロルヘキシジングルコン酸塩又はクロルヘキシジン塩酸塩を含有する製剤に記載すること． ただし，「，クロルヘキシジン」はクロルヘキシジングルコン酸塩又はクロルヘキシジン塩酸塩を含有する製剤にのみ記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-ng-2",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "2.",
      "body": "次の部位には使用しないこと",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-ng-2-1",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "2.(1)",
      "body": "目や目の周囲，粘膜（例えば，口腔，鼻腔，膣等），陰のう，外陰部等．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-ng-2-2",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "2.(2)",
      "body": "湿疹．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-ng-2-3",
      "groupId": "mizumushi",
      "section": "してはいけないこと",
      "itemNo": "2.(3)",
      "body": "湿潤，ただれ，亀裂や外傷のひどい患部．",
      "condition": {
        "dosageForm": [
          "外用液剤",
          "軟膏剤",
          "エアゾール剤"
        ]
      },
      "conditionText": "外用液剤，軟膏剤又はエアゾール剤の場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.",
      "body": "次の人は使用前に医師，薬剤師又は登録販売者に相談すること",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-1",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(1)",
      "body": "医師の治療を受けている人．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-2",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(2)",
      "body": "乳幼児．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-3",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(3)",
      "body": "薬などによりアレルギー症状を起こしたことがある人．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-4",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(4)",
      "body": "患部が顔面又は広範囲の人．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-5",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(5)",
      "body": "患部が化膿している人．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-1-6",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "1.(6)",
      "body": "「湿疹」か「みずむし，いんきんたむし，ぜにたむし」かがはっきりしない人．\n（陰のうにかゆみ・ただれ等の症状がある場合は，湿疹等他の原因による場合が多い．）",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.",
      "body": "使用後，次の症状があらわれた場合は副作用の可能性があるので，直ちに使用を中止し，この文書を持って医師，薬剤師又は登録販売者に相談すること\n関係部位 症状\n皮膚 発疹・発赤，かゆみ，かぶれ，はれ，刺激感",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r1",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r1",
      "body": "皮膚 熱感，疼痛",
      "condition": {
        "hasIngredient": [
          "エコナゾール硝酸塩",
          "クロトリマゾール"
        ]
      },
      "conditionText": "１）は，エコナゾール硝酸塩又はクロトリマゾールを含有する製剤に",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r2",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r2",
      "body": "皮膚 熱感，乾燥感，ヒリヒリ感",
      "condition": {
        "hasIngredient": [
          "クロタミトン"
        ]
      },
      "conditionText": "２）は，クロタミトンを含有する製剤に ただし，｢乾燥・つっぱり感｣を記載した製剤にあっては「乾燥感」は記載しない．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r3",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r3",
      "body": "皮膚 落屑",
      "condition": {
        "hasIngredient": [
          "ミコナゾール硝酸塩",
          "チオコナゾール"
        ]
      },
      "conditionText": "３）は，ミコナゾール硝酸塩又はチオコナゾールを含有する製剤に",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r4",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r4",
      "body": "皮膚 ただれ",
      "condition": {
        "hasIngredient": [
          "エキサラミド",
          "クロトリマゾール",
          "エコナゾール硝酸塩",
          "ミコナゾール硝酸塩",
          "チオコナゾール",
          "シクロピロクスオラミン",
          "トルシクラート"
        ]
      },
      "conditionText": "４）は，エキサラミド，クロトリマゾール，エコナゾール硝酸塩，ミコナゾール硝酸塩，チオコナゾール，シクロピロクスオラミン又はトルシクラートを含有する製剤に",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r5",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r5",
      "body": "皮膚 乾燥・つっぱり感",
      "condition": {
        "hasIngredient": [
          "ミコナゾール硝酸塩",
          "チオコナゾール",
          "トルシクラート"
        ]
      },
      "conditionText": "５）は，ミコナゾール硝酸塩，チオコナゾール又はトルシクラートを含有する製剤に",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r6",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r6",
      "body": "皮膚 水疱",
      "condition": {
        "hasIngredient": [
          "エコナゾール硝酸塩",
          "ミコナゾール硝酸塩",
          "チオコナゾール",
          "トルシクラート"
        ]
      },
      "conditionText": "６）は，エコナゾール硝酸塩，ミコナゾール硝酸塩，チオコナゾール又はトルシクラートを含有する製剤に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-2-r7",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "2.r7",
      "body": "まれに下記の重篤な症状が起こることがある．その場合は直ちに医師の診療を受けること．\nショック（アナフィラキシー） 使用後すぐに，皮膚のかゆみ，じんましん，声のかすれ，くしゃみ，のどのかゆみ，息苦しさ，動悸，意識の混濁等があらわれる．",
      "condition": {
        "hasIngredient": [
          "ヨードチンキ",
          "クロルヘキシジングルコン酸塩",
          "クロルヘキシジン塩酸塩"
        ]
      },
      "conditionText": "ヨードチンキ，クロルヘキシジングルコン酸塩又はクロルヘキシジン塩酸塩を含有する製剤に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-sd-3",
      "groupId": "mizumushi",
      "section": "相談すること",
      "itemNo": "3.",
      "body": "２週間位使用しても症状がよくならない場合は使用を中止し，この文書を持って医師，薬剤師又は登録販売者に相談すること",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-youho-1",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(1)",
      "body": "患部やその周囲が汚れたまま使用しないこと．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-youho-2",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(2)",
      "body": "目に入らないように注意すること．万一，目に入った場合には，すぐに水又はぬるま湯で洗い，直ちに眼科医の診療を受けること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-youho-3",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(3)",
      "body": "小児に使用させる場合には，保護者の指導監督のもとに使用させること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-youho-4",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(4)",
      "body": "外用にのみ使用すること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-youho-5",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(5)",
      "body": "使用前によく振とうすること．",
      "condition": {
        "not": {
          "always": true
        }
      },
      "conditionText": "必要な場合に記載すること．",
      "excludedBy": [],
      "needsReview": true
    },
    {
      "id": "mizumushi-etc-youho-6",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(6)",
      "body": "患部まで○○cm の距離で噴霧すること．",
      "condition": {
        "dosageForm": [
          "エアゾール剤"
        ]
      },
      "conditionText": "エアゾール剤の場合に当該製品の至適な距離を記載すること．",
      "excludedBy": [],
      "needsReview": true
    },
    {
      "id": "mizumushi-etc-youho-7",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(7)",
      "body": "同じ箇所に連続して○○秒以上噴霧しないこと．",
      "condition": {
        "dosageForm": [
          "エアゾール剤"
        ]
      },
      "conditionText": "エアゾール剤の場合に当該製品の至適な時間を３秒を超えない範囲で記載すること．",
      "excludedBy": [],
      "needsReview": true
    },
    {
      "id": "mizumushi-etc-hokan-1",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(1)",
      "body": "直射日光の当たらない（湿気の少ない）涼しい所に（密栓して）保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": "（ ）内は必要とする場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-hokan-2",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(2)",
      "body": "小児の手の届かない所に保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "mizumushi-etc-hokan-3",
      "groupId": "mizumushi",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(3)",
      "body": "他の容器に入れ替えないこと（誤用の原因になったり品質が変わる．）．",
      "condition": {
        "always": true
      },
      "conditionText": "容器等の個々に至適表示がなされていて，誤用のおそれのない場合には記載しなくてもよい．",
      "excludedBy": [],
      "needsReview": false
    }
  ]
}
