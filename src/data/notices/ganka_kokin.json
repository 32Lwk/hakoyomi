    {
      "id": "ganka_kokin-etc-youho-1",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(1)",
      "body": "過度に使用すると，異常なまぶしさを感じたり，かえって充血を招くことがある．",
      "condition": {
        "hasClass": [
          "充血除去成分"
        ]
      },
      "conditionText": "充血除去成分を含有する製剤に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-youho-2",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(2)",
      "body": "小児に使用させる場合には，保護者の指導監督のもとに使用させること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-youho-3",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(3)",
      "body": "容器の先をまぶた，まつ毛に触れさせないこと．また，混濁したものは使用しないこと．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-youho-4",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(4)",
      "body": "ソフトコンタクトレンズを装着したまま使用しないこと．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-youho-5",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "用法及び用量に関連する注意(5)",
      "body": "点眼用にのみ使用すること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-hokan-1",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(1)",
      "body": "直射日光の当たらない（湿気の少ない）涼しい所に（密栓して）保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": "（ ）内は必要とする場合に記載すること．",
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-hokan-2",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(2)",
      "body": "小児の手の届かない所に保管すること．",
      "condition": {
        "always": true
      },
      "conditionText": null,
      "excludedBy": [],
      "needsReview": false
    },
    {
      "id": "ganka_kokin-etc-hokan-3",
      "groupId": "ganka_kokin",
      "section": "その他",
      "itemNo": "保管及び取扱い上の注意(3)",
      "body": "他の容器に入れ替えないこと（誤用の原因になったり品質が変わる．）．",
      "condition": {
        "always": true
      },
      "conditionText": "容器等の個々に至適表示がなされていて，誤用のおそれのない場合には記載しなくてもよい．",
