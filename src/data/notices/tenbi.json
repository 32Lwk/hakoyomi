      "needsReview": false
    },
    {
      "id": "tenbi-ng-2",
      "groupId": "tenbi",
      "section": "してはいけないこと",
      "itemNo": "2.",
      "body": "授乳中の人は本剤を使用しないか，本剤を使用する場合は授乳を避けること",
      "condition": {
        "hasIngredient": [
          "ジフェンヒドラミン塩酸塩",
